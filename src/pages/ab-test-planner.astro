---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ABTestPlanner from '../components/ABTestPlanner/ABTestPlanner';
import '../styles/global.css';

const title = 'A/B Test Planner - How Long Should Your Test Run?';
const description = 'Plan your A/B test before running it. Enter your app metrics and see how many days you need for each variable and lift threshold. Free tool for app developers.';
const keywords = 'A/B test planner, A/B test duration, sample size calculator, test planning, paywall testing, mobile app optimization, statistical power';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "A/B Test Planner",
  "description": description,
  "url": "https://tools.dennislysenko.tech/ab-test-planner",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Any (Browser-based)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Calculate test duration for trial starts, purchases, and LTV",
    "See timelines for 10%, 20%, and 50% detectable lifts",
    "Support for 2-8 variants with Bonferroni correction",
    "Warnings when test timelines are unrealistic",
    "Helper text for finding metrics in RevenueCat and Adapty",
    "100% browser-based - no data leaves your device"
  ],
  "author": {
    "@type": "Person",
    "name": "Dennis Lysenko",
    "url": "https://dennislysenko.tech"
  },
  "browserRequirements": "Requires JavaScript. Works with modern browsers.",
  "softwareVersion": "1.0.0",
  "datePublished": new Date().toISOString().split('T')[0]
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalUrl="/ab-test-planner"
  jsonLd={jsonLd}
>
  <main class="app-container">
    <div class="app-wrapper">
      <nav class="back-nav">
        <a href="/" class="back-link">&larr; All Tools</a>
      </nav>
      <header class="hero-section">
        <div class="hero-content">
          <div class="title-group">
            <h1 class="hero-title">How long should your A/B test run?</h1>
            <span class="construction-badge">UNDER CONSTRUCTION</span>
          </div>
          <p class="hero-description">
            Enter your metrics. See exactly how many days you need for each variable and lift threshold.
          </p>
        </div>
      </header>

      <section>
        <ABTestPlanner client:load />
      </section>

      <Footer message="Plan your A/B tests before running them. Know exactly how much traffic you need, and avoid drawing conclusions from insufficient data." />
    </div>
  </main>
</Layout>

<style>
  .app-container {
    min-height: 100vh;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }

  .app-wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  .hero-section {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .title-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero-description {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 65ch;
  }

  @media (max-width: 768px) {
    .title-group {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (min-width: 1600px) {
    .app-wrapper {
      max-width: 1500px;
    }
  }
</style>
