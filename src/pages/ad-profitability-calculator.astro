---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import AdCalculator from '../components/AdCalculator/AdCalculator';
import '../styles/global.css';

// SEO metadata
const title = 'Ad Profitability Calculator - Free ROAS Tool for App Developers';
const description = 'Calculate ad profitability for Meta and Apple Search Ads campaigns. See your ROAS instantly, simulate scenarios, and find your breakeven point. Free, browser-based tool.';
const keywords = 'ROAS calculator, ad profitability, cost per install, CPI calculator, Meta ads, Apple Search Ads, CPM calculator, app marketing, user acquisition, mobile app ads';

// JSON-LD Structured Data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Ad Profitability Calculator",
  "description": description,
  "url": "https://tools.dennislysenko.tech/ad-profitability-calculator",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Any (Browser-based)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Calculate ROAS for Meta (CPM) and Apple Search Ads (CPT) campaigns",
    "Interactive scenario modeling - tweak any metric and see instant results",
    "Pre-filled with industry average benchmarks",
    "Full funnel visibility from impression to paying subscriber",
    "Visual breakeven analysis with color-coded indicators",
    "100% browser-based - no data leaves your device"
  ],
  "author": {
    "@type": "Person",
    "name": "Dennis Lysenko",
    "url": "https://dennislysenko.tech"
  },
  "browserRequirements": "Requires JavaScript. Works with modern browsers (Chrome, Firefox, Safari, Edge).",
  "softwareVersion": "1.0.0",
  "datePublished": new Date().toISOString().split('T')[0]
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalUrl="/ad-profitability-calculator"
  jsonLd={jsonLd}
>
  <main class="app-container">
    <div class="app-wrapper">
      <!-- Hero Section -->
      <header class="hero-section">
        <div class="hero-content">
          <div class="title-group">
            <h1 class="hero-title">Are your ads profitable?</h1>
          </div>
          <p class="hero-description">
            Plug in your metrics, see your ROAS instantly. Simulate scenarios to find your path to profitability.
          </p>
        </div>
      </header>

      <!-- Calculator -->
      <section>
        <AdCalculator client:load />
      </section>

      <Footer />
    </div>
  </main>
</Layout>

<style>
  .app-container {
    min-height: 100vh;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }

  .app-wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  .hero-section {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .title-group {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero-description {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 65ch;
  }

  @media (max-width: 768px) {
    .title-group {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (min-width: 1600px) {
    .app-wrapper {
      max-width: 1500px;
    }

    .hero-section {
      margin-bottom: 6rem;
    }
  }
</style>
