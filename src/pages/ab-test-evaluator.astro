---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ABTestEvaluator from '../components/ABTestEvaluator/ABTestEvaluator';
import '../styles/global.css';

const title = 'A/B Test Evaluator - Can You Trust Your Results?';
const description = 'Evaluate the trustworthiness of your A/B test results. See what\'s significant, what to ignore, and how much longer you need to run. Free, browser-based tool for app developers.';
const keywords = 'A/B test calculator, A/B test significance, statistical significance, paywall testing, conversion rate testing, mobile app A/B test, sample size calculator';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "A/B Test Evaluator",
  "description": description,
  "url": "https://tools.dennislysenko.tech/ab-test-evaluator",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Any (Browser-based)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Evaluate A/B test results with statistical rigor",
    "See which results are significant and which to ignore",
    "Calculate how many more samples you need",
    "Support for trial starts, purchases, and LTV metrics",
    "Bonferroni correction for multiple variants",
    "100% browser-based - no data leaves your device"
  ],
  "author": {
    "@type": "Person",
    "name": "Dennis Lysenko",
    "url": "https://dennislysenko.tech"
  },
  "browserRequirements": "Requires JavaScript. Works with modern browsers.",
  "softwareVersion": "1.0.0",
  "datePublished": new Date().toISOString().split('T')[0]
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonicalUrl="/ab-test-evaluator"
  jsonLd={jsonLd}
>
  <main class="app-container">
    <div class="app-wrapper">
      <nav class="back-nav">
        <a href="/" class="back-link">&larr; All Tools</a>
      </nav>
      <header class="hero-section">
        <div class="hero-content">
          <div class="title-group">
            <h1 class="hero-title">Can you trust your A/B test results?</h1>
            <span class="beta-badge">BETA</span>
          </div>
          <p class="hero-description">
            Enter your data. See what's real, what to ignore, and how long you need to keep running.
          </p>
        </div>
      </header>

      <section>
        <ABTestEvaluator client:load />
      </section>

      <Footer message="This tool helps app developers evaluate A/B test results with statistical rigor. No data leaves your browser — everything is calculated client-side." />
    </div>
  </main>
</Layout>

<style>
  .app-container {
    min-height: 100vh;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
  }

  .app-wrapper {
    max-width: 1400px;
    margin: 0 auto;
  }

  .hero-section {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .title-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .hero-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero-description {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 65ch;
  }

  @media (max-width: 768px) {
    .title-group {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  @media (min-width: 1600px) {
    .app-wrapper {
      max-width: 1500px;
    }
  }
</style>
